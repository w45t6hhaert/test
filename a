local function getContrastColor(bgColor)
if not bgColor then return Color3.new(1, 1, 1) end
local luminance = (bgColor.R * 299 + bgColor.G * 587 + bgColor.B * 114) / 1000
return luminance > 0.5 and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
end
local function compactScale(obj, scale)
if not obj then return end
pcall(function()
local s = Instance.new("UIScale"); s.Scale = scale; s.Parent = obj
end)
end
