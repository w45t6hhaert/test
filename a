-- Silent Aim System (Hookmetamethod)
-- ============================================================
local saMouse = Players.LocalPlayer:GetMouse()

local function getSilentAimTarget()
    if not config.silentaim.enabled then return nil end
    
    local cameraPos = camera.CFrame.Position
    local mouseX, mouseY = S.guiState.mouseX, S.guiState.mouseY
    local fovRadiusSq = config.silentaim.settings.fovRadius * config.silentaim.settings.fovRadius
    local bestScore = math.huge
    local bestData = nil
    local targetMode = config.silentaim.targetPart.head and "Head" or "Torso"

    for i = 1, #S.activePlayers do
        local p = S.activePlayers[i]
        local d = S.playerData[p]
        if p ~= localPlayer and d and d.humanoidRootPart and d.humanoidRootPart.Parent then
            if config.silentaim.settings.teamCheck and d.isSameTeam then continue end
            if config.whitelist[p] then continue end
            
            local hrp = d.humanoidRootPart
            local distSq = (hrp.Position - cameraPos).Magnitude ^ 2
            if distSq > (config.silentaim.settings.maxDistance ^ 2) then continue end

            local fovPart = (targetMode == "Head" and d.cachedHead) or d.cachedTorso
            if not fovPart or not fovPart.Parent then fovPart = hrp end

            local sp, vis = camera:WorldToViewportPoint(fovPart.Position)
            if vis and sp.Z > 0 then
                local dx = sp.X - mouseX; local dy = sp.Y - mouseY
                local screenDistSq = dx * dx + dy * dy
                if screenDistSq <= fovRadiusSq then
                    if config.silentaim.settings.wallCheck then
                        if not hasLineOfSight(cameraPos, fovPart) then continue end
                    end
                    
                    local score = screenDistSq + distSq * 0.1
                    if score < bestScore then
                        bestScore = score
                        bestData = { player = p, data = d, part = fovPart }
                    end
                end
            end
        end
    end
    return bestData
end

local function shouldApplySilentAim()
    local hitChance = config.silentaim.settings.hitChance
    if hitChance >= 100 then return true end
    if hitChance <= 0 then return false end
    return math.random(1, 100) <= hitChance
end

local sa_old_namecall, sa_old_index

if hookmetamethod and newcclosure and checkcaller then
    sa_old_namecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if not checkcaller() and config.silentaim.enabled then
            local targetData = getSilentAimTarget()
            if targetData and shouldApplySilentAim() then
                local targetPos = config.silentaim.settings.prediction 
                    and getPredictedPosition(targetData.part) 
                    or targetData.part.Position
                    
                local localChar = localPlayer.Character
                local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")
                
                local isLocalRaycast = false
                if localHRP and typeof(args[1]) == "Vector3" then
                    if (localHRP.Position - args[1]).Magnitude < 15 then
                        isLocalRaycast = true
                    end
                elseif typeof(args[1]) == "Ray" then
                    if localHRP and (localHRP.Position - args[1].Origin).Magnitude < 15 then
                        isLocalRaycast = true
                    end
                end

                if isLocalRaycast then
                    if method == "Raycast" then
                        local origin = args[1]
                        local direction = args[2]
                        if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" then
                            args[2] = (targetPos - origin).Unit * direction.Magnitude
                            return sa_old_namecall(self, unpack(args))
                        end
                    elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
                        local ray = args[1]
                        if typeof(ray) == "Ray" then
                            local newDir = (targetPos - ray.Origin).Unit * ray.Direction.Magnitude
                            args[1] = Ray.new(ray.Origin, newDir)
                            return sa_old_namecall(self, unpack(args))
                        end
                    end
                end
            end
        end
        return sa_old_namecall(self, ...)
    end))

    sa_old_index = hookmetamethod(game, "__index", newcclosure(function(self, key)
        if not checkcaller() and config.silentaim.enabled then
            local targetData = getSilentAimTarget()
            if targetData and self == saMouse and shouldApplySilentAim() then
                local targetPos = config.silentaim.settings.prediction 
                    and getPredictedPosition(targetData.part) 
                    or targetData.part.Position
                
                if key == "Hit" then
                    return CFrame.new(targetPos)
                elseif key == "Target" then
                    return targetData.part
                elseif key == "UnitRay" then
                    local origin = camera.CFrame.Position
                    local direction = (targetPos - origin).Unit
                    return Ray.new(origin, direction)
                end
            end
        end
        return sa_old_index(self, key)
