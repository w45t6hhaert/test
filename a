    local relX = dx * camRight.X + dy * camRight.Y + dz * camRight.Z
    local relY = -(dx * camUp.X + dy * camUp.Y + dz * camUp.Z)

    local magSq = relX * relX + relY * relY

    if magSq < 0.0001 then
        relX, relY, magSq = 0, -1, 1
    end

    local invMag = 1 / math.sqrt(magSq)
    local normX = relX * invMag
    local normY = relY * invMag

    local halfW, halfH = vpW * 0.5, vpH * 0.5

    local radius = math.clamp(
        (config.aim.settings and config.aim.settings.indicatorDistance)
        or config.aim.indicatorDistance
        or 50,
        20,
        400
    )

    -- Evita que el indicador se salga completamente de la pantalla
    local maxRadius = math.max(math.min(halfW, halfH) - 12, 20)
    if radius > maxRadius then
        radius = maxRadius
    end

    -- MEDIDA DESDE EL CENTRO
    local targetX = halfW + normX * radius
    local targetY = halfH + normY * radius

    if osState.currentPosX == 0 and osState.currentPosY == 0 then
        osState.currentPosX = targetX
        osState.currentPosY = targetY
        osState.currentDirX = normX
        osState.currentDirY = normY
    end

    local lerpFactor = math.clamp((offscreenLerpDt or 0.016) * 14, 0, 1)

    osState.currentPosX = osState.currentPosX + (targetX - osState.currentPosX) * lerpFactor
    osState.currentPosY = osState.currentPosY + (targetY - osState.currentPosY) * lerpFactor
    osState.currentDirX = osState.currentDirX + (normX - osState.currentDirX) * lerpFactor
    osState.currentDirY = osState.currentDirY + (normY - osState.currentDirY) * lerpFactor

    local dirMagSq = osState.currentDirX * osState.currentDirX + osState.currentDirY * osState.currentDirY

    if dirMagSq > 0.0001 then
        local inv = 1 / math.sqrt(dirMagSq)
        osState.currentDirX = osState.currentDirX * inv
        osState.currentDirY = osState.currentDirY * inv
    else
        osState.currentDirX, osState.currentDirY = normX, normY
    end

    local drawX = math.clamp(osState.currentPosX, 10, vpW - 10)
    local drawY = math.clamp(osState.currentPosY, 10, vpH - 10)

    local dirX, dirY = osState.currentDirX, osState.currentDirY

    local triSize = math.clamp(
        (config.aim.settings and config.aim.settings.triangleSize)
        or config.aim.triangleSize
        or 8,
        4,
        26
    )

    local tipX, tipY = dirX, dirY

    local leftX = tipX * COS_25 - tipY * SIN_25
    local leftY = tipY * COS_25 + tipX * SIN_25

    local rightX = tipX * COS_25 + tipY * SIN_25
    local rightY = tipY * COS_25 - tipX * SIN_25

    local p1X, p1Y = drawX + tipX * triSize, drawY + tipY * triSize
    local p2X, p2Y = drawX + leftX * triSize * 0.72, drawY + leftY * triSize * 0.72
    local p3X, p3Y = drawX + rightX * triSize * 0.72, drawY + rightY * triSize * 0.72

    data.os1.From = Vector2.new(p1X, p1Y)
    data.os1.To = Vector2.new(p2X, p2Y)

    data.os2.From = Vector2.new(p2X, p2Y)
    data.os2.To = Vector2.new(p3X, p3Y)

    data.os3.From = Vector2.new(p3X, p3Y)
    data.os3.To = Vector2.new(p1X, p1Y)

    if data.os1.Color ~= color then
        data.os1.Color = color
        data.os2.Color = color
        data.os3.Color = color
    end

    if not data.osVisible then
        data.os1.Visible = true
        data.os2.Visible = true
        data.os3.Visible = true
        data.osVisible = true
        data._allHidden = false
    end
end
