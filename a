local function hasLineOfSight(fromPos, toPart)
if not config.aim.settings.wallCheck then return true end
local toPartParent = toPart and toPart.Parent
if not toPart or not toPartParent then return false end
local id = getObjectId(toPart)
local cached = S.wallCheckCache[id]
if cached and (S.frameCount - cached.frame) < (C.WALL_CHECK_CACHE_FRAMES or 4) then return cached.result end
S.aimRaycastFilterInstances[1] = localPlayer.Character
