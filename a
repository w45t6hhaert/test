local TeamSys = {}
S.TeamSys = TeamSys
TeamSys.ttl = 0.5
TeamSys.retryTtl = 2
TeamSys.cache = setmetatable({}, {__mode = "k"})
TeamSys.universalKey = nil
TeamSys.universalNext = 0

TeamSys.teamKeys = {
    "Team", "team", "TeamName", "TeamId", "TeamID",
    "Side", "Faction", "Squad", "Party", "Clan", "Group", "Ally"
}
TeamSys.allyFlags = {
    "Teammate", "IsTeammate", "isTeammate",
    "Ally", "IsAlly", "Friendly", "SameTeam", "IsTeam"
}

local function teamKeyFrom(v)
    local t = typeof(v)
    if t == "string" then
        if v == "" then return nil end
        return (v:gsub("^%s+", ""):gsub("%s+$", "")):lower()
    elseif t == "number" then return tostring(v)
    elseif t == "BrickColor" then return v.Name:lower()
    elseif t == "Color3" then return "#" .. v:ToHex():lower()
    elseif t == "Instance" then return v.Name:lower()
    end
    return nil
end

local function teamColorFrom(v, key)
    local t = typeof(v)
    if t == "BrickColor" then return v.Color end
    if t == "Color3" then return v end
    if t == "Instance" and v:IsA("Team") then return v.TeamColor.Color end
    if not key then return nil end
    local h = 0
    for i = 1, #key do h = (h * 31 + string.byte(key, i)) % 360 end
    return Color3.fromHSV(h / 360, 0.7, 1)
end

local function readTeamFrom(obj, names)
    if not obj then return nil end
    for i = 1, #names do
        local n = names[i]
        local ok, a = pcall(obj.GetAttribute, obj, n)
        if ok and a ~= nil then
            local k = teamKeyFrom(a)
            if k then return k, teamColorFrom(a, k) end
        end
        local ch = obj:FindFirstChild(n)
        if ch then
            if ch:IsA("ValueBase") then
                local ok2, val = pcall(function() return ch.Value end)
                if ok2 and val ~= nil then
                    local k = teamKeyFrom(val)
                    if k then return k, teamColorFrom(val, k) end
                end
            elseif ch:IsA("Folder") or ch:IsA("Model") or ch:IsA("Team") then
                local k = ch.Name:lower()
                return k, teamColorFrom(ch, k)
            end
        end
    end
    return nil
end

local function readAllyFlag(obj)
    if not obj then return nil end
    for i = 1, #TeamSys.allyFlags do
        local n = TeamSys.allyFlags[i]
        local ok, a = pcall(obj.GetAttribute, obj, n)
        if ok and type(a) == "boolean" then return a end
        local ch = obj:FindFirstChild(n)
        if ch and ch:IsA("BoolValue") then return ch.Value end
    end
    return nil
end

local function readTeamFromContainers(player, char)
    local uid, nm = tostring(player.UserId), player.Name:lower()
    for _, root in ipairs({workspace, game:GetService("ReplicatedStorage")}) do
        for _, cname in ipairs({"Teams", "Factions", "Squads", "Parties"}) do
            local cont = root:FindFirstChild(cname)
            if cont then
                for _, team in ipairs(cont:GetChildren()) do
                    local k = team.Name:lower()
                    if team:FindFirstChild(player.Name) or team:FindFirstChild(uid) then
                        return k, teamColorFrom(team, k)
                    end
                    for _, v in ipairs(team:GetChildren()) do
                        if v:IsA("ValueBase") then
                            local ok, val = pcall(function() return v.Value end)
                            if ok then
                                if val == player or (char and val == char) then
                                    return k, teamColorFrom(team, k)
                                end
                                if type(val) == "string" and (val:lower() == nm or val == uid) then
                                    return k, teamColorFrom(team, k)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

function TeamSys.resolve(player, force)
    if not player or not isPlayerEntity(player) then return nil, nil end
    local now = os.clock()
    local c = TeamSys.cache[player]
    if not force and c and (now - c.t) < (c.key and TeamSys.ttl or TeamSys.retryTtl) then
        return c.key, c.color
    end
    local char = player.Character
    local key, color
    local t = player.Team
    if t and not player.Neutral then
        key, color = t.Name:lower(), t.TeamColor.Color
    end
    if not key then key, color = readTeamFrom(player, TeamSys.teamKeys) end
    if not key then key, color = readTeamFrom(char, TeamSys.teamKeys) end
    if not key and char and char.Parent and char.Parent.Parent then
        local gp = char.Parent.Parent.Name:lower()
        if gp:find("team") or gp:find("faction") or gp:find("squad") then
            key = char.Parent.Name:lower()
            color = teamColorFrom(char.Parent, key)
        end
    end
    if not key then
        local ally = readAllyFlag(char)
        if ally == nil then ally = readAllyFlag(player) end
        if ally == true then key, color = "__ally__", config.colors.whitelist end
    end
    if not key then key, color = readTeamFromContainers(player, char) end
    if key and not color then color = teamColorFrom(nil, key) end
    TeamSys.cache[player] = {key = key, color = color, t = now}
    return key, color
end

function TeamSys.UpdateUniversal()
    local now = os.clock()
    if now < TeamSys.universalNext then return end
    TeamSys.universalNext = now + 3
    local counts, total = {}, 0
    for _, p in ipairs(Players:GetPlayers()) do
        local k = TeamSys.resolve(p)
        if k then counts[k] = (counts[k] or 0) + 1; total = total + 1 end
    end
    TeamSys.universalKey = nil
    if total >= 3 then
        for k, n in pairs(counts) do
            if n == total then TeamSys.universalKey = k break end
        end
    end
end

function TeamSys.Invalidate(player)
    TeamSys.cache[player] = nil
end
local function isSameTeam(player)
    if not player or not isPlayerEntity(player) or player == localPlayer then return false end
    local tk = TeamSys.resolve(player)
