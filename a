function S.restoreCollision(character)
local char = character or localPlayer.Character
if not char then return end
local hum = char:FindFirstChildOfClass("Humanoid")
local rootPart = (hum and hum.RootPart) or char:FindFirstChild("HumanoidRootPart")
for _, part in ipairs(char:GetDescendants()) do
if part:IsA("BasePart") then
local parent, skip = part.Parent, false
while parent and parent ~= char do
if parent:IsA("Accessory") or parent:IsA("Tool") then skip = true; break end
parent = parent.Parent
end
if not skip then part.CanCollide = (part == rootPart) end
end
end
if rootPart then pcall(function() rootPart.CanCollide = true end) end
if hum then
pcall(function() hum.PlatformStand = false end)
pcall(function()
if hum:GetState() == Enum.HumanoidStateType.Physics then hum:ChangeState(Enum.HumanoidStateType.Running) end
end)
end
end
