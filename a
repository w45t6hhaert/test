for i = 1, length do result[i] = string.char(Util.CharsetBytes[math.random(1, 62)]) end
return table.concat(result)
end
Util.GuiUniqueId = generateRandomString(18)
local function secureConnect(signal, callback)
local conn = signal:Connect(callback)
if conn then Util.ActiveConnections[#Util.ActiveConnections + 1] = conn return conn end
end
local function playerConnect(player, signal, callback)
local conns = Util.PlayerConnections[player]
if not conns then conns = {}; Util.PlayerConnections[player] = conns end
local conn = signal:Connect(callback)
if conn then conns[#conns + 1] = conn return conn end
end
local function disconnectPlayerConnections(player)
local conns = Util.PlayerConnections[player]
if not conns then return end
for i = 1, #conns do conns[i]:Disconnect() end
Util.PlayerConnections[player] = nil
end
