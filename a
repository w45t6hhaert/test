if type(readfile) ~= "function" then return false, "Tu executor no soporta archivos." end
local path = C.SAVES_SUBFOLDER .. "/" .. name .. ".json"
if not isfile(path) then return false, "No existe." end
local ok, data = pcall(function() return game:GetService("HttpService"):JSONDecode(readfile(path)) end)
if not ok or type(data) ~= "table" then return false, "JSON inválido." end
if not deserialize(data) then return false, "No se pudo aplicar." end
return true
end
