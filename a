end
for i = 1, #priorityParts do
local part = character:FindFirstChild(priorityParts[i])
if part and part:IsA("BasePart") and (not config.aim.settings.wallCheck or hasLineOfSight(cameraPos, part)) then
S.visiblePartCache[cacheKey] = {result = part, frame = S.frameCount}; return part
end
end
S.visiblePartCache[cacheKey] = {result = nil, frame = S.frameCount}; return nil
end
-- 13 Velocity and Prediction
local function getvelocity(part)
if not part or not part.Parent then return Vector3.new() end
return part.AssemblyLinearVelocity or part.Velocity or Vector3.new()
end
local function resetVelocityHistory(pid)
S.velocityHistory[pid] = {sum = Vector3.new(), count = 0, history = table.create(5), index = 1}
end
local function getSmoothedVelocity(part)
if not part then return Vector3.new() end
local pid = getObjectId(part); local data = S.velocityHistory[pid]
if not data or data.count == 0 then return getvelocity(part) end
return data.sum / data.count
end
local function getPredictedPosition(part)
if not part or not part.Parent then return nil end
local id = getObjectId(part); local cached = S.predictionCache[id]
if cached and cached.frame == S.frameCount then return cached.result end
local basePos = part.Position
if not config.aim.settings.prediction or config.aim.settings.predictionMultiplier <= 0 then
S.predictionCache[id] = {result = basePos, frame = S.frameCount}; return basePos
end
local vel = getSmoothedVelocity(part)
if vel.Magnitude < 1 then S.predictionCache[id] = {result = basePos, frame = S.frameCount}; return basePos end
local pingMs = 50
pcall(function() pingMs = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() end)
local pingSec = pingMs / 1000
local reactionBuffer = 0.05
local totalTime = pingSec + reactionBuffer + config.aim.settings.predictionMultiplier
local offset = vel * totalTime
if offset.Magnitude > 50 then offset = offset.Unit * 50 end
local result = basePos + offset
S.predictionCache[id] = {result = result, frame = S.frameCount}; return result
end
-- 14 Target Acquisition
local function getClosestTarget()
if not config.aim.enabled then return nil, nil end
local cameraPos = camera.CFrame.Position
local targetMode = config.aim.targetPart.head and "Head" or "Torso"
local mouseX, mouseY = S.guiState.mouseX, S.guiState.mouseY
local fovRadius = config.aim.settings.fovRadius
local fovRadiusSq = fovRadius * fovRadius
if config.aim.currentPart and config.aim.currentPart.Parent and config.aim.lockedPlayer then
local locked = config.aim.lockedPlayer
local data = S.playerData[locked]
local lockedChar = isPlayerEntity(locked) and locked.Character or locked
if locked and locked.Parent and data and lockedChar and isAlive(lockedChar)
and not shouldIgnorePlayer(locked, "aim", data) then
return config.aim.currentPart, locked
end
if config.aim.currentPart then S.velocityHistory[getObjectId(config.aim.currentPart)] = nil end
config.aim.currentPart = nil; config.aim.currentPartRef = nil; config.aim.lockedPlayer = nil
end
local bestScore = math.huge; local bestPlayer = nil
local entitiesToCheck = {}
for _, p in ipairs(S.activePlayers) do table.insert(entitiesToCheck, p) end
if config.aim.settings.lockToNPCs then
for _, npc in ipairs(S.activeNPCs) do table.insert(entitiesToCheck, npc) end
end
for i = 1, #entitiesToCheck do
local p = entitiesToCheck[i]; local d = S.playerData[p]
local isP = isPlayerEntity(p); local char = isP and p.Character or p
if p ~= localPlayer and d and char and isAlive(char) and not shouldIgnorePlayer(p, "aim", d) then
if not d.humanoidRootPart or not d.humanoidRootPart.Parent then
d.humanoidRootPart = char:FindFirstChild("HumanoidRootPart")
if not d.humanoidRootPart and d.humanoid then d.humanoidRootPart = d.humanoid.RootPart end
end
local hrp = d.humanoidRootPart
if hrp then
local fovPart = (targetMode == "Head" and d.cachedHead) or d.cachedTorso
if not fovPart or not fovPart.Parent then fovPart = hrp end
local sp, vis = camera:WorldToViewportPoint(fovPart.Position)
if vis and sp.Z > 0 then
local dx = sp.X - mouseX; local dy = sp.Y - mouseY
local screenDistSq = dx * dx + dy * dy
if screenDistSq <= fovRadiusSq then
local worldDist = (hrp.Position - cameraPos).Magnitude
local score = math.sqrt(screenDistSq) + worldDist * 0.25
if score < bestScore then bestScore = score; bestPlayer = p end
end
end
end
end
end
if bestPlayer then
local bestChar = isPlayerEntity(bestPlayer) and bestPlayer.Character or bestPlayer
local part = getBestVisiblePart(bestChar, cameraPos, targetMode)
if part then
if config.aim.currentPart and config.aim.currentPart ~= part then
S.velocityHistory[getObjectId(config.aim.currentPart)] = nil
end
config.aim.currentPart = part; config.aim.currentPartRef = part; config.aim.lockedPlayer = bestPlayer
if config.aim.settings.prediction then resetVelocityHistory(getObjectId(part)) end
return config.aim.currentPart, config.aim.lockedPlayer
end
end
return nil, nil
end
