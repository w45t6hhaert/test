local json = game:GetService("HttpService"):JSONEncode(serialize())
local path = C.SAVES_SUBFOLDER .. "/" .. name .. ".json"
if isfile(path) then pcall(function() writefile(path .. ".bak", readfile(path)) end) end
writefile(path, json)
end)
return ok, ok and nil or tostring(err)
end
function S.saves.load(name)
