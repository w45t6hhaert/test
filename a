S.aimRaycastParams.FilterDescendantsInstances = S.aimRaycastFilterInstances
local result = workspace:Raycast(fromPos, toPart.Position - fromPos, S.aimRaycastParams)
local isVisible = true
if result then
local hitParent = result.Instance and result.Instance.Parent
isVisible = hitParent == localPlayer.Character or hitParent == toPart.Parent
end
S.wallCheckCache[id] = {result = isVisible, frame = S.frameCount}
return isVisible
end
